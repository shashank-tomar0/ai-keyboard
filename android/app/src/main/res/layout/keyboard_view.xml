<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C1C1E"
    android:padding="4dp">

    <!-- AI Toolbar above keyboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">
        
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            android:layout_marginEnd="8dp"
            android:contentDescription="AI Icon"/>

        <Button
            android:id="@+id/btn_ai_magic"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="✨ Smart Reply"
            android:backgroundTint="#2C2C2E"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_grammar"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Fix Grammar"
            android:backgroundTint="#2C2C2E"
            android:textColor="#D6F287"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_tone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="👔 Tone"
            android:backgroundTint="#2C2C2E"
            android:textColor="#8168FF"
            android:textSize="12sp"
            android:padding="0dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C2E"
        android:layout_marginBottom="4dp"/>

    <!-- Standard Android KeyboardView styled -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        android:keyBackground="@drawable/key_background"
        android:keyTextColor="#FFFFFF"
        android:shadowColor="#000000"
        android:shadowRadius="0.0" />

</LinearLayout>
