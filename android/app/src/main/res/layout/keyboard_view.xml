<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C1C1E"
    android:padding="8dp">

    <!-- AI Toolbar above keyboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">
        
        <Button
            android:id="@+id/btn_ai_magic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ AI Magic"
            android:backgroundTint="#FDE17A"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_grammar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grammar"
            android:backgroundTint="#D6F287"
            android:textColor="#000000"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_tone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tone"
            android:backgroundTint="#8168FF"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Standard Android KeyboardView (Deprecated but easiest for a quick prototype, later we can use Custom Layouts) -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2C2C2E"
        android:keyBackground="@android:color/transparent"
        android:keyTextColor="#FFFFFF" />

</LinearLayout>
